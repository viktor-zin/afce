{
    "name": {
        "en_US": "AutoIt 3",
        "ru_RU": "AutoIt 3",
        "uk_UA": "AutoIt 3"
    },
    "additional_settings": {
        "indentation_preference": "    ",
        "variable_prefix": "$",
        "case_insensitive": true,
        "keywords": [
            "and", "or", "not", "true", "false", "default", "null", "to", "step", "in"
        ],
        "operators": {
            "==": "=", "!=": "<>", "&&": "And", "||": "Or", "!": "Not", "true": "True",
            "false": "False",
            "%": {"binary": "Mod(%1, %2)"},
            "/": {"binary": "Int(%1 / %2)", "when": "int"}
        },
        "casts": {
            "int": "Int(%1)", "real": "Number(%1)", "char": "Chr(%1)", "*": "%1"
        },
        "literals": {
            "string": {
                "item": "\"%$text%\"",
                "text_escape": {
                    "\"": "\"\"",
                    "\\\"": "\"\"",
                    "\\'": "'",
                    "\\\\": "\\",
                    "\\n": "\" & @LF & \"",
                    "\\t": "\" & @TAB & \""
                }
            }
        }
    },
    "comment": {
        "template": "; %text%"
    },
    "algorithm": {
        "template": [
            "Func %name%(%args%)",
            "\t%decl%",
            "\t%branch1%",
            "EndFunc",
            "%entry%"
        ],
        "template_empty_params": [
            "%name%()",
            "",
            "Func %name%()",
            "\t%decl%",
            "\t%branch1%",
            "EndFunc"
        ],
        "defaults": {
            "name": "Main"
        },
        "list": {
            "args": {
                "source": "params",
                "item": "%$name%",
                "glue": ", "
            },
            "decl": {
                "source": "variables",
                "head": "Local ",
                "glue": ", "
            },
            "entry": {
                "source": "main_params",
                "item": "\n%name%($CmdLine[0] + 1, $CmdLine)",
                "limit": 1
            }
        }
    },
    "process": {
        "template": "%text%"
    },
    "assign": {
        "template": "%dest% = %src%"
    },
    "call": {
        "template": "%text|callparens%"
    },
    "io": {
        "template": "%vars%",
        "list": {
            "vars": {
                "item": "%$% = Number(InputBox(\"Input\", \"%$|raw%\"))",
                "glue": "\n"
            }
        }
    },
    "ou": {
        "template": "ConsoleWrite(%vars% & @CRLF)",
        "template_empty_vars": "ConsoleWrite(@CRLF)",
        "list": {
            "vars": {
                "item": "%$|operand%",
                "glue": " & ",
                "literal_item": "\"%$text%\"",
                "text_escape": {
                    "\"": "\"\"",
                    "\\\"": "\"\"",
                    "\\'": "'",
                    "\\\\": "\\",
                    "\\n": "\" & @LF & \"",
                    "\\t": "\" & @TAB & \""
                }
            }
        }
    },
    "if": {
        "template": [
            "If %cond% Then",
            "\t%branch1%",
            "Else",
            "\t%branch2%",
            "EndIf"
        ],
        "template_empty_branch2": [
            "If %cond% Then",
            "\t%branch1%",
            "EndIf"
        ],
        "template_empty_branch1": [
            "If %cond|negate% Then",
            "\t%branch2%",
            "EndIf"
        ],
        "template_empty_branch1+branch2": [
            "If %cond% Then",
            "EndIf"
        ],
        "chain": {
            "head": [
                "If %cond% Then",
                "\t%branch1%"
            ],
            "else_if": [
                "ElseIf %cond% Then",
                "\t%branch1%"
            ],
            "else": [
                "Else",
                "\t%branch2%"
            ],
            "end": "EndIf"
        }
    },
    "case": {
        "template": [
            "Switch %expr%",
            "%branches%",
            "EndSwitch"
        ],
        "case_branch": [
            "\tCase %value%",
            "\t\t%body%"
        ],
        "default_branch": [
            "\tCase Else",
            "\t\t%body%"
        ],
        "default_branch_empty": "",
        "list": {
            "value": {
                "glue": ", ",
                "literal_item": "\"%$text%\"",
                "text_escape": {
                    "\"": "\"\"",
                    "\\\"": "\"\"",
                    "\\'": "'",
                    "\\\\": "\\",
                    "\\n": "\" & @LF & \"",
                    "\\t": "\" & @TAB & \""
                }
            }
        }
    },
    "pre": {
        "template": [
            "While %cond%",
            "\t%branch1%",
            "WEnd"
        ]
    },
    "post": {
        "template": [
            "Do",
            "\t%branch1%",
            "Until %cond|negate%"
        ]
    },
    "for": {
        "template": [
            "For %var|lvalue% = %from% To %to%",
            "\t%branch1%",
            "Next"
        ]
    },
    "forc": {
        "template": [
            "%init|cstmt%",
            "While %cond%",
            "\t%branch1%",
            "\t%step|cstmt%",
            "WEnd"
        ],
        "defaults": {
            "cond": "True"
        }
    },
    "foreach": {
        "template": [
            "For %var|name% In %range%",
            "\t%branch1%",
            "Next"
        ]
    },
    "return": {
        "template": "Return %value%",
        "template_empty_value": "Return"
    },
    "break": {
        "template": "ExitLoop",
        "template_in_case": "; break out of the case: not supported",
        "template_in_case_last": ""
    },
    "continue": {
        "template": "ContinueLoop",
        "template_in_forc": [
            "%loop.step|cstmt%",
            "ContinueLoop"
        ],
        "template_in_forc_last": ""
    }
}

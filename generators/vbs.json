{
    "name": {
        "en_US": "VBScript, Visual Basic",
        "ru_RU": "VBScript, Visual Basic",
        "uk_UA": "VBScript, Visual Basic"
    },
    "additional_settings": {
        "indentation_preference": "    ",
        "case_insensitive": true,
        "keywords": [
            "and", "or", "not", "xor", "eqv", "imp", "mod", "is", "true", "false", "nothing", "null", "empty"
        ],
        "operators": {
            "==": "=", "!=": "<>", "&&": "And", "||": "Or", "!": "Not", "true": "True",
            "false": "False",
            "[": "(", "]": ")",
            "%": {"binary": "%1 Mod %2"},
            "/": {"binary": "%1 \\ %2", "when": "int"}
        },
        "casts": {
            "int": "Fix(%1)", "real": "CDbl(%1)", "char": "Chr(%1)", "bool": "CBool(%1)", "*": "%1"
        },
        "literals": {
            "string": {
                "item": "\"%$text%\"",
                "text_escape": {
                    "\"": "\"\"",
                    "\\\"": "\"\"",
                    "\\'": "'",
                    "\\\\": "\\",
                    "\\n": "\" & vbLf & \"",
                    "\\t": "\" & vbTab & \""
                }
            }
        }
    },
    "comment": {
        "template": "' %text%"
    },
    "algorithm": {
        "template": [
            "Function %name%(%args%)",
            "\t%decl%",
            "\t%branch1%",
            "End Function",
            "%entry%"
        ],
        "template_empty_params": [
            "Function %name%()",
            "\t%decl%",
            "\t%branch1%",
            "End Function",
            "",
            "%name%"
        ],
        "template_empty_returns": [
            "Sub %name%(%args%)",
            "\t%decl%",
            "\t%branch1%",
            "End Sub",
            "%entry%"
        ],
        "template_empty_params+returns": [
            "Sub %name%()",
            "\t%decl%",
            "\t%branch1%",
            "End Sub",
            "",
            "%name%"
        ],
        "defaults": {
            "name": "Main"
        },
        "list": {
            "args": {
                "source": "params",
                "item": "%$name%",
                "glue": ", "
            },
            "decl": {
                "source": "variables",
                "head": "Dim ",
                "glue": ", "
            },
            "entry": {
                "source": "main_params",
                "item": "\n%name% WScript.Arguments.Count + 1, WScript.Arguments",
                "limit": 1
            }
        }
    },
    "process": {
        "template": "%text%"
    },
    "assign": {
        "template": "%dest% = %src%"
    },
    "call": {
        "template": "Call %text%"
    },
    "io": {
        "template": "%vars%",
        "list": {
            "vars": {
                "item": "%$% = CLng(InputBox(\"%$%\"))",
                "glue": "\n"
            }
        }
    },
    "ou": {
        "template": "WScript.Echo %vars%",
        "template_empty_vars": "WScript.Echo",
        "list": {
            "vars": {
                "item": "%$|operand%",
                "glue": " & ",
                "literal_item": "\"%$text%\"",
                "text_escape": {
                    "\"": "\"\"",
                    "\\\"": "\"\"",
                    "\\'": "'",
                    "\\\\": "\\",
                    "\\n": "\" & vbLf & \"",
                    "\\t": "\" & vbTab & \""
                }
            }
        }
    },
    "if": {
        "template": [
            "If %cond|truthy% Then",
            "\t%branch1%",
            "Else",
            "\t%branch2%",
            "End If"
        ],
        "template_empty_branch2": [
            "If %cond|truthy% Then",
            "\t%branch1%",
            "End If"
        ],
        "template_empty_branch1": [
            "If %cond|truthy|negate% Then",
            "\t%branch2%",
            "End If"
        ],
        "template_empty_branch1+branch2": [
            "If %cond|truthy% Then",
            "End If"
        ],
        "chain": {
            "head": [
                "If %cond|truthy% Then",
                "\t%branch1%"
            ],
            "else_if": [
                "ElseIf %cond|truthy% Then",
                "\t%branch1%"
            ],
            "else": [
                "Else",
                "\t%branch2%"
            ],
            "end": "End If"
        }
    },
    "case": {
        "template": [
            "Select Case %expr%",
            "%branches%",
            "End Select"
        ],
        "case_branch": [
            "\tCase %value%",
            "\t\t%body%"
        ],
        "default_branch": [
            "\tCase Else",
            "\t\t%body%"
        ],
        "default_branch_empty": "",
        "list": {
            "value": {
                "glue": ", ",
                "literal_item": "\"%$text%\"",
                "text_escape": {
                    "\"": "\"\"",
                    "\\\"": "\"\"",
                    "\\'": "'",
                    "\\\\": "\\",
                    "\\n": "\" & vbLf & \"",
                    "\\t": "\" & vbTab & \""
                }
            }
        }
    },
    "pre": {
        "template": [
            "Do While %cond|truthy%",
            "\t%branch1%",
            "Loop"
        ]
    },
    "post": {
        "template": [
            "Do",
            "\t%branch1%",
            "Loop While %cond|truthy%"
        ]
    },
    "for": {
        "template": [
            "For %var|lvalue% = %from% To %to%",
            "\t%branch1%",
            "Next"
        ]
    },
    "forc": {
        "template": [
            "%init|cstmt%",
            "Do While %cond|truthy%",
            "\t%branch1%",
            "\t%step|cstmt%",
            "Loop"
        ],
        "defaults": {
            "cond": "True"
        }
    },
    "foreach": {
        "template": [
            "For Each %var|name% In %range%",
            "\t%branch1%",
            "Next"
        ]
    },
    "return": {
        "template": [
            "%algorithm.name% = %value%",
            "Exit Function"
        ],
        "template_empty_value": "Exit Function",
        "template_empty_algorithm.returns": "Exit Sub"
    },
    "break": {
        "template": "Exit Do",
        "template_in_for": "Exit For",
        "template_in_foreach": "Exit For",
        "template_in_case": "' break out of the case: not supported",
        "template_in_case_last": ""
    },
    "continue": {
        "template": "' continue: not supported in VBScript",
        "template_in_pre_last": "",
        "template_in_post_last": "",
        "template_in_for_last": "",
        "template_in_forc_last": "",
        "template_in_foreach_last": ""
    }
}

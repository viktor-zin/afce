<!DOCTYPE AFC>
<algorithm version="1.3" name="classify" params="int n" returns="int">
  <branch>
    <io vars="n"/>
    <assign dest="s" src="0"/>
    <call text="init(n)"/>
    <case expr="n % 4">
      <branch value="0">
        <ou vars="&quot;zero&quot;"/>
      </branch>
      <branch value="1,3">
        <ou vars="&quot;odd&quot;"/>
        <break/>
      </branch>
      <branch value="2">
        <return value="-1"/>
      </branch>
      <branch>
        <process text="k = 0"/>
      </branch>
    </case>
    <forc init="int i = 0" cond="i &lt; n" step="i++">
      <branch>
        <if cond="i % 2 == 0">
          <branch>
            <continue/>
          </branch>
          <branch/>
        </if>
        <call text="print(i)"/>
      </branch>
    </forc>
    <foreach var="x" range="items">
      <branch>
        <if cond="x &lt; 0">
          <branch>
            <break/>
          </branch>
          <branch>
            <assign dest="s" src="s + x"/>
          </branch>
        </if>
      </branch>
    </foreach>
    <forc cond="" init="" step="">
      <branch>
        <if cond="done()">
          <branch>
            <break/>
          </branch>
          <branch/>
        </if>
        <call text="step()"/>
      </branch>
    </forc>
    <if cond="s &gt; 100">
      <branch>
        <return value="1"/>
      </branch>
      <branch>
        <return value="0"/>
      </branch>
    </if>
  </branch>
</algorithm>

<!DOCTYPE AFC>
<algorithm version="1.3">
  <branch>
    <io vars="n"/>
    <assign dest="s" src="0"/>
    <post cond="n &gt; 0">
      <branch>
        <assign dest="s" src="s + n % 10"/>
        <assign dest="n" src="n / 10"/>
      </branch>
    </post>
    <ou vars="s"/>
  </branch>
</algorithm>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE AFC>
<algorithm version="1.3">
  <branch>
    <for var="v" from="0" to="6">
      <branch>
        <case expr="v">
          <branch value="1, 2">
            <ou vars="v, &quot; small&quot;"/>
          </branch>
          <branch value="3">
            <ou vars="v, &quot; three&quot;"/>
          </branch>
          <branch value="5">
            <ou vars="v, &quot; five&quot;"/>
            <continue/>
          </branch>
          <branch>
            <ou vars="v, &quot; other&quot;"/>
          </branch>
        </case>
        <ou vars="&quot;end &quot;, v"/>
      </branch>
    </for>
    <assign dest="w" src="2"/>
    <case expr="w">
      <branch value="2">
        <ou vars="&quot;two&quot;"/>
        <break/>
      </branch>
      <branch/>
    </case>
    <for var="q" from="1" to="3">
      <branch>
        <case expr="q">
          <branch value="2">
            <ou vars="&quot;q two&quot;"/>
            <break/>
          </branch>
          <branch>
            <ou vars="&quot;q &quot;, q"/>
          </branch>
        </case>
      </branch>
    </for>
    <case expr="w + 1">
      <branch value="1">
        <ou vars="&quot;one&quot;"/>
      </branch>
      <branch value="3, 4">
        <ou vars="&quot;three or four&quot;"/>
      </branch>
      <branch>
        <ou vars="&quot;none&quot;"/>
      </branch>
    </case>
    <case expr="w * 10">
      <branch value="1">
        <ou vars="&quot;one&quot;"/>
      </branch>
      <branch>
        <ou vars="&quot;default &quot;, w * 10"/>
      </branch>
    </case>
  </branch>
</algorithm>

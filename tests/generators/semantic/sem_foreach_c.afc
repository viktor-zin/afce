<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE AFC>
<algorithm version="1.3">
  <branch>
    <process text="int arr[] = {3, 1, 4, 1, 5, 9, 2}"/>
    <assign dest="t" src="0"/>
    <foreach var="x" range="arr">
      <branch>
        <if cond="x == 1">
          <branch>
            <continue/>
          </branch>
          <branch/>
        </if>
        <if cond="x &gt; 8">
          <branch>
            <break/>
          </branch>
          <branch/>
        </if>
        <assign dest="t" src="t + x"/>
        <ou vars="&quot;x = &quot;, x"/>
      </branch>
    </foreach>
    <ou vars="&quot;t = &quot;, t"/>
  </branch>
</algorithm>

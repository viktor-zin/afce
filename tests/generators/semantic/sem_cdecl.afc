<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE AFC>
<!-- C/C++ only: declarations kept by the importer, typed output, declarations inside case branches -->
<algorithm version="1.3">
  <branch>
    <process text="int i = 1"/>
    <case expr="i">
      <branch value="1">
        <process text="int y = i * 2"/>
        <ou vars="&quot;y = &quot;, y"/>
      </branch>
      <branch value="2">
        <process text="const char *t = &quot;two&quot;"/>
        <ou vars="&quot;t = &quot;, t"/>
      </branch>
      <branch>
        <process text="int y = 0"/>
        <ou vars="&quot;y = &quot;, y"/>
      </branch>
    </case>
    <process text="double x = 3.14;&#10;char ch = 'z';&#10;const char *s = &quot;abc&quot;"/>
    <process text="char name[20] = &quot;Bob&quot;"/>
    <ou vars="s, &quot;|&quot;, ch, &quot;|&quot;, x, &quot;|&quot;, name[0]"/>
    <ou vars="&quot;Hello, &quot;, name, &quot;!&quot;"/>
    <assign dest="half" src="(double) i / 4"/>
    <assign dest="word" src="&quot;two&quot;"/>
    <assign dest="letter" src="'q'"/>
    <assign dest="flag" src="i &gt; 0"/>
    <ou vars="half, &quot; &quot;, word, &quot; &quot;, letter, &quot; &quot;, flag"/>
  </branch>
</algorithm>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE AFC>
<algorithm version="1.3">
  <branch>
    <case expr="x">
      <branch value="1">
        <ou vars="&quot;one&quot;"/>
      </branch>
      <branch value="2, 3">
        <ou vars="&quot;two or three&quot;"/>
      </branch>
      <branch>
        <ou vars="&quot;other&quot;"/>
      </branch>
    </case>
    <case expr="c">
      <branch value="'a'">
        <assign dest="n" src="1"/>
        <break/>
      </branch>
      <branch value="'b', 'c'">
        <assign dest="n" src="2"/>
      </branch>
      <branch value=""/>
    </case>
  </branch>
</algorithm>

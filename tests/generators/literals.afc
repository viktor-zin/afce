<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE AFC>
<!-- string and char literals in expressions and output items -->
<algorithm version="1.3">
  <branch>
    <assign dest="name" src="&quot;Bob&quot;"/>
    <assign dest="c" src="'x'"/>
    <assign dest="q" src="&quot;it's \&quot;ok\&quot;\n&quot;"/>
    <if cond="c == 'y' || name == &quot;Al&quot;">
      <branch>
        <ou vars="name"/>
      </branch>
      <branch/>
    </if>
    <ou vars="&quot;Price: $x, e-mail a@b.c, #{x}&quot;, '\t', c, '\''"/>
    <ou vars="(c == 'x') + 1, &quot; done&quot;"/>
  </branch>
</algorithm>

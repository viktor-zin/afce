<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE AFC>
<!-- "void" parameter list and return type, as the importer writes them for f(void) / void f() -->
<algorithm version="1.3" name="beep" params="void" returns=" void ">
  <branch>
    <ou vars="&quot;beep&quot;"/>
    <return/>
  </branch>
</algorithm>
